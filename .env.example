# Resend API Key for contact form email functionality
# Get your key from https://resend.com
# Required for production deployment
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address where contact form submissions are sent
# Required for production deployment
CONTACT_TO_EMAIL=your-email@example.com

# (Optional) Sender email address for outgoing emails
# Must be verified in Resend dashboard if using custom domain
# Defaults to noreply@yourdomain.com if not provided
CONTACT_FROM_EMAIL=noreply@yourdomain.com
